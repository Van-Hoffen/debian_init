# ==============================================================================
# СПИСОК ОТСЛЕЖИВАЕМЫХ СЕРВИСОВ ДЛЯ WELCOME SCREEN
# Формат: одно имя сервиса (без .service) на строку. Пустые строки и строки
# с '#' игнорируются. Показываются только реально установленные сервисы.
# Файл устанавливается debian_init и перезаписывается при обновлении
# (старая версия — в /var/backups/debian_init/).
# ==============================================================================

# Корпоративные и российские решения
CommuniGate         # Основной сервис почтового сервера CommuniGate Pro
rupost              # Основной сервис почтовой системы RuPost от Astra Linux
tegu                # Почтовый сервер Tegu (российская разработка)
zimbra              # Платформа для совместной работы Zimbra Collaboration

# ── Системы документооборота (СЭД / ECM) ──────────────────────────────────────
elma365             # Основной сервис ELMA365 (если развернут через systemd)
elma365-worker      # Фоновые обработчики задач ELMA365
dvsupservice        # Сервис DVSupService для Docsvision (Linux)
tessa               # Основной веб-сервис платформы Tessa (Syntellect)
tessa-chronos       # Сервис фоновых задач и расписаний Tessa
diretum             # Основной процесс Directum RX (если установлен как сервис)

# ── Инфраструктура 1С:Предприятие ─────────────────────────────────────────────
srv1cv83            # Сервер 1С:Предприятие8.3 (агент сервера)
srv1cv82            # Сервер 1С:Предприятие8.2 (агент сервера)
ras                 # Сервер администрирования кластера 1С (Remote Administration Server)
ragent              # Агент кластера серверов 1С
rmngr               # Менеджер кластера серверов 1С
rphost              # Рабочий процесс кластера 1С

# ── Веб-серверы и прокси ──────────────────────────────────────────────────────
nginx               # Популярный веб-сервер и обратный прокси
apache2             # Классический веб-сервер (в системах Debian/Ubuntu)
httpd               # Классический веб-сервер (в системах RHEL/ALT Linux)
haproxy             # Высокопроизводительный балансировщик нагрузки TCP/HTTP
varnish             # Кэширующий HTTP-прокси (ускоритель сайтов)
traefik             # Современный edge-роутер и прокси (часто для Docker/K8s)

# ── Базы данных и кэширование ─────────────────────────────────────────────────
postgresql          # Мощная объектно-реляционная СУБД
mysql               # Популярная реляционная СУБД
mariadb             # Форк MySQL с открытым исходным кодом
redis               # In-memory структура данных (кэш и брокер сообщений)
memcached           # Система кэширования данных в оперативной памяти
mongodb             # Документоориентированная NoSQL СУБД
clickhouse-server   # Колоночная аналитическая СУБД для обработки больших данных
influxdb            # СУБД для работы с временными рядами (Time Series)

# ── Инфраструктура Proxmox VE (Виртуализация) ─────────────────────────────────
pve-cluster         # Файловая система кластера Proxmox (pmxcfs)
pvedaemon           # Основной API-демон управления Proxmox
pveproxy            # REST API прокси (обеспечивает работу веб-интерфейса)
pvestatd            # Демон сбора статистики (опрос VM, контейнеров и хранилищ)
pvescheduler        # Планировщик задач Proxmox (бэкапы, репликация)
corosync            # Демон кластерного взаимодействия и обеспечения кворума

# ── Proxmox Mail Gateway (PMG) ────────────────────────────────────────────────
pmgdaemon           # Основной API-демон управления Proxmox Mail Gateway
pmgproxy            # REST API прокси (обеспечивает работу веб-интерфейса PMG)
pmg-smtp-filter     # Демон фильтрации SMTP (сканирование на спам и вирусы)
pmgpolicy           # Демон применения политик (правила обработки почты)
pmgmirror           # Демон синхронизации базы данных (для работы PMG в кластере)
pmgtunnel           # Демон кластерного туннеля (для связи нод PMG)
clamav-freshclam    # Утилита обновления антивирусных баз ClamAV (важна для PMG)

# ── Proxmox Backup Server (PBS) ───────────────────────────────────────────────
proxmox-backup-api   # Основной API-сервер бэкап-системы Proxmox
proxmox-backup-proxy # API-прокси сервер (отвечает за интерфейс и передачу данных)
proxmox-backup-banner# Вывод баннера (приветствия) при входе по SSH/консоли

# ── Контейнеры и оркестрация ──────────────────────────────────────────────────
docker              # Платформа для запуска и управления контейнерами
containerd          # Базовая среда выполнения контейнеров
k3s                 # Легковесный дистрибутив Kubernetes
kubelet             # Основной агент узла в кластере Kubernetes
crio                # Легковесная среда выполнения контейнеров для Kubernetes

# ── Безопасность и Firewall ───────────────────────────────────────────────────
ssh                 # Демон SSH-сервера (название сервиса в некоторых ОС)
sshd                # Демон SSH-сервера (название сервиса в RHEL/ALT)
fail2ban            # Сервис защиты от брутфорса (блокировка по IP)
firewalld           # Динамический межсетевой экран
iptables            # Классическая утилита управления файрволом

# ── Мониторинг и метрики ──────────────────────────────────────────────────────
grafana             # Платформа визуализации данных и дашбордов
prometheus          # Система сбора метрик и алертинга
node_exporter       # Экспортер системных метрик серверов для Prometheus
zabbix-server       # Сервер системы мониторинга Zabbix
zabbix-agent        # Агент сбора данных для Zabbix
zabbix-agent2       # Агент Zabbix 2 (ставится install.sh из packages/base.list)
alertmanager        # Компонент Prometheus для обработки оповещений

# ── Почта и групповая работа ──────────────────────────────────────────────────
postfix             # Агент передачи сообщений (MTA / SMTP-сервер)
exim                # Популярный MTA (часто используется вместо Postfix)
dovecot             # Сервер входящей почты (IMAP / POP3)
sogod               # Сервер групповой работы SOGo (почта, календарь, контакты)
amavis              # Интерфейс между MTA и антивирусом/антиспамом
spamassassin        # Мощный фильтр защиты от спама
opendkim            # Сервис подписи исходящих писем ключами DKIM

# ── DNS, VPN и сеть ───────────────────────────────────────────────────────────
named               # Демон DNS-сервера BIND (в RHEL/ALT/CentOS)
bind9               # Демон DNS-сервера BIND (в Debian/Ubuntu)
openvpn             # Сервер/клиент виртуальной частной сети
wireguard           # Современный, быстрый и легковесный VPN-туннель
strongswan          # Популярная реализация IPsec VPN

# ── Очереди и брокеры сообщений ───────────────────────────────────────────────
rabbitmq-server     # Надежный брокер сообщений (протокол AMQP)
kafka               # Распределенная платформа потоковой передачи событий

# ── Резервное копирование ─────────────────────────────────────────────────────
bacula-dir          # Основной управляющий демон системы бэкапов Bacula
borgbackup          # Система дедуплицирующего резервного копирования

# ── Базовые системные сервисы ─────────────────────────────────────────────────
cron                # Планировщик периодических задач (в Debian/Ubuntu)
crond               # Планировщик периодических задач (в RHEL/ALT/CentOS)
ntpd                # Классический демон синхронизации времени по сети
chronyd             # Современный и точный демон синхронизации времени (NTP)
rsyslog             # Система сбора, обработки и пересылки системных логов
