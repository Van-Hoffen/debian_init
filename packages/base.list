# =============================================================================
# Базовые пакеты — ставятся на любую машину.
# Формат: одно имя на строку, '#' — комментарий.
# Отсутствующие в текущем релизе пакеты пропускаются с предупреждением
# (например, fastfetch нет в Debian 12).
# =============================================================================

# --- Доступ и сеть -----------------------------------------------------------
sudo
curl
wget
ca-certificates
gnupg
net-tools           # ifconfig/netstat (устаревшие, но привычные)
bind9-dnsutils      # dig, nslookup
nload

# --- Оболочка и окружение (нужны .bashrc / .bash_welcome / .tmux.conf) ------
tmux
bash-completion     # подключается в .bashrc
procps              # vmstat/free/ps — статусная строка tmux
fzf
fastfetch           # запасной вариант welcome screen (нет в Debian 12)
wtmpdb              # команда last в Debian 13 (util-linux её больше не содержит)
libpam-wtmpdb       # запись входов в базу wtmpdb
less
mc
htop
ncdu

# --- Архивы (функция extract в .bash_aliases) --------------------------------
unzip
zip
bzip2
xz-utils
zstd

# --- Разработка и диагностика ------------------------------------------------
git
build-essential
strace
file
lsb-release

# --- Почта и мониторинг ------------------------------------------------------
mutt                # чтение локальной почты (/var/mail), см. welcome screen
zabbix-agent2       # настройка: ./install.sh --only zabbix --zabbix-server ADDR
